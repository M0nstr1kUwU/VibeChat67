[
  {
    "id": "dark",
    "name": "Dark",
    "rules": [
      {
        "selector": ".app",
        "properties": {
          "background": "#111318",
          "color": "#f2f3f5"
        }
      },
      {
        "selector": ".user-switcher",
        "properties": {
          "background": "#111318",
          "border-color": "#252830"
        }
      },
      {
        "selector": ".chat-info",
        "properties": {
          "background": "#111318",
          "border-color": "#252830"
        }
      },
      {
        "selector": ".app-tabs",
        "properties": {
          "background": "#111318",
          "border-color": "#252830"
        }
      },
      {
        "selector": ".messages",
        "properties": {
          "background": "#111318"
        }
      },
      {
        "selector": ".message",
        "properties": {
          "background": "#20232a",
          "border-color": "#30343d",
          "color": "#f2f3f5",
          "border-radius": "5px 17px 17px 17px"
        }
      },
      {
        "selector": ".message-wrapper.own .message",
        "properties": {
          "background": "#304b7d",
          "border-color": "#4165a8",
          "color": "#f7f9ff",
          "border-radius": "17px 5px 17px 17px"
        }
      },
      {
        "selector": ".message p",
        "properties": {
          "color": "inherit"
        }
      },
      {
        "selector": ".author-name",
        "properties": {
          "background": "#292d36",
          "color": "#b9c2d2"
        }
      },
      {
        "selector": ".author-name.own-name",
        "properties": {
          "background": "#303f65",
          "color": "#e0e9ff"
        }
      },
      {
        "selector": ".message-actions .action-button",
        "properties": {
          "background": "#20232a",
          "border-color": "#343842",
          "color": "#d9dde5"
        }
      },
      {
        "selector": ".messages::-webkit-scrollbar-thumb",
        "properties": {
          "background": "#3a3e49"
        }
      }
    ]
  },
  {
    "id": "light",
